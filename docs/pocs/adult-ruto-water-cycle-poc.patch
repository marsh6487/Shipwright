     EnViewer_SetupAction(this, EnViewerStatic_WaitForObjects);
 }
+
+static bool EnViewerStatic_IsWaterCycle(const StaticStoryPoseDescriptor* poseDescriptor) {
+    return poseDescriptor != NULL && (poseDescriptor->flags & STATIC_POSE_FLAG_WATER_CYCLE) != 0;
+}
+
+static bool EnViewerStatic_PlayerNearWaterSurface(EnViewer* this, PlayState* play) {
+    Player* player = GET_PLAYER(play);
+    Vec3f surfacePos = this->actor.world.pos;
+
+    surfacePos.y += this->actor.yDistToWater;
+    return Math_Vec3f_DistXZ(&surfacePos, &player->actor.world.pos) < 240.0f &&
+           fabsf(player->actor.world.pos.y - surfacePos.y) < 80.0f;
+}
+
+static void EnViewerStatic_SetRutoSwimDirection(EnViewer* this, s32 direction) {
+    AnimationHeader* animation = &gAdultRutoSwimmingUpAnim;
+    f32 endFrame = Animation_GetLastFrame(animation);
+
+    if (direction < 0) {
+        Animation_Change(&this->skin.skelAnime, animation, -1.0f, endFrame, 0.0f, ANIMMODE_LOOP, -8.0f);
+    } else if (direction > 0) {
+        Animation_Change(&this->skin.skelAnime, animation, 1.0f, 0.0f, endFrame, ANIMMODE_LOOP, -8.0f);
+    } else {
+        this->skin.skelAnime.playSpeed = 0.0f;
+    }
+}
+
+static bool EnViewerStatic_UpdateRutoWaterCycle(EnViewer* this, PlayState* play) {
+    bool playerNear;
+
+    Actor_MoveXZGravity(&this->actor);
+    Actor_UpdateBgCheckInfo(play, &this->actor, this->staticState.collider.dim.radius,
+                            this->staticState.collider.dim.height * 0.25f, 0.0f, 5);
+
+    if (!(this->actor.bgCheckFlags & BGCHECKFLAG_WATER)) {
+        this->actor.velocity.y = 0.0f;
+        this->staticState.waterState = ENVIEWER_STATIC_WATER_SUBMERGED;
+        this->actor.flags &= ~ACTOR_FLAG_ATTENTION_ENABLED;
+        return false;
+    }
+
+    playerNear = EnViewerStatic_PlayerNearWaterSurface(this, play);
+    switch (this->staticState.waterState) {
+        case ENVIEWER_STATIC_WATER_SUBMERGED:
+            this->actor.flags &= ~ACTOR_FLAG_ATTENTION_ENABLED;
+            this->actor.velocity.y = 0.0f;
+            EnViewerStatic_SetRutoSwimDirection(this, 0);
+            if (this->actor.yDistToWater < 54.0f) {
+                this->staticState.waterState = ENVIEWER_STATIC_WATER_TREADING;
+                this->staticState.waterTimer = Rand_S16Offset(40, 40);
+                this->actor.flags |= ACTOR_FLAG_ATTENTION_ENABLED;
+                EnViewerStatic_SetRutoSwimDirection(this, 1);
+            } else if (playerNear) {
+                this->staticState.waterState = ENVIEWER_STATIC_WATER_SURFACING;
+                this->actor.velocity.y = 4.0f;
+                EnViewerStatic_SetRutoSwimDirection(this, 1);
+            }
+            return false;
+
+        case ENVIEWER_STATIC_WATER_SURFACING:
+            this->actor.flags &= ~ACTOR_FLAG_ATTENTION_ENABLED;
+            if (this->actor.yDistToWater < 54.0f) {
+                this->actor.velocity.y = 0.0f;
+                this->staticState.waterState = ENVIEWER_STATIC_WATER_TREADING;
+                this->staticState.waterTimer = Rand_S16Offset(40, 40);
+                this->actor.flags |= ACTOR_FLAG_ATTENTION_ENABLED;
+            } else if (this->actor.yDistToWater < 80.0f) {
+                Math_ApproachF(&this->actor.velocity.y, 2.0f, 0.4f, 0.6f);
+            }
+            return false;
+
+        case ENVIEWER_STATIC_WATER_TREADING:
+            this->actor.flags |= ACTOR_FLAG_ATTENTION_ENABLED;
+            Math_ApproachF(&this->actor.velocity.y, this->actor.yDistToWater < 54.0f ? -0.6f : 0.6f, 0.3f, 0.2f);
+            if (playerNear) {
+                this->staticState.waterTimer = Rand_S16Offset(40, 40);
+            } else if (this->staticState.waterTimer > 0) {
+                this->staticState.waterTimer--;
+            } else {
+                this->staticState.waterState = ENVIEWER_STATIC_WATER_DIVING;
+                this->actor.flags &= ~ACTOR_FLAG_ATTENTION_ENABLED;
+                this->actor.velocity.y = -4.0f;
+                EnViewerStatic_SetRutoSwimDirection(this, -1);
+                return false;
+            }
+            return true;
+
+        case ENVIEWER_STATIC_WATER_DIVING:
+            this->actor.flags &= ~ACTOR_FLAG_ATTENTION_ENABLED;
+            Math_ApproachF(&this->actor.velocity.y, -1.0f, 0.4f, 0.6f);
+            if (this->actor.world.pos.y <= this->actor.home.pos.y + 2.0f ||
+                (this->actor.bgCheckFlags & BGCHECKFLAG_GROUND)) {
+                this->actor.world.pos = this->actor.home.pos;
+                this->actor.velocity.y = 0.0f;
+                this->staticState.waterState = ENVIEWER_STATIC_WATER_SUBMERGED;
+                EnViewerStatic_SetRutoSwimDirection(this, 0);
+            }
+            return false;
+    }
+
+    return false;
+}
